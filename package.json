{
  "name": "novaq-desktop",
  "version": "1.0.4",
  "description": "NovaQ Desktop",
  "main": "src/main.js",
  "scripts": {
    "kill-3201": "bash -lc 'pids=$(lsof -ti:3201 || true); if [ -n \"$pids\" ]; then echo \"Killing processes on 3201: $pids\"; kill -9 $pids || true; fi'",
    "start": "cross-env NODE_ENV=production APP_VERSION=1.0.4 electron .",
    "start:prod": "cross-env NODE_ENV=production APP_VERSION=1.0.4 electron .",
    "dev": "cross-env NODE_ENV=development APP_VERSION=1.0.4 electron . --dev --no-asar",
    "dev:test": "npm run webpack:build && cross-env NODE_ENV=development APP_VERSION=1.0.4 electron . --dev --no-asar",
    "webpack:dev": "webpack serve --mode development",
    "webpack:build": "cross-env NODE_ENV=development webpack --mode development",
    "webpack:build:prod": "npm run build:updater:32 && cross-env NODE_ENV=production API_BASE_URL=https://novaq.mn:3119 APP_VERSION=1.0.4 webpack --mode production",
    "react-start": "webpack serve --mode development --open",
    "build": "npm run webpack:build:prod",
    "build:install:prod": "npm run webpack:build:prod && npx electron-builder --win nsis --ia32 --config.nsis.artifactName=NovaQ_Desk.${ext}",
    "dev:live": "concurrently \"npm run webpack:dev\" \"wait-on http://localhost:3201/bundle.js && npm run dev\"",
    "release": "./scripts/release.sh",
    "dist": "electron-builder",
    "build:win": "npm run webpack:build:prod && npm run build:updater:both && electron-builder --win zip",
    "build:portable": "npm run webpack:build:prod && npm run build:updater:both && electron-builder --win zip && npm run clean:portable",
    "build:win-universal": "npm run webpack:build:prod && npm run build:updater:both && electron-builder --win zip",
    "build:win-universal:portable": "npm run webpack:build:prod && npm run build:updater:both && electron-builder --win zip && npm run clean:portable",
    "build:universal": "powershell -ExecutionPolicy Bypass -File scripts/build-universal-windows.ps1",
    "build:universal:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-universal-windows.ps1 --portable",
    "build:all-in-one": "powershell -ExecutionPolicy Bypass -File scripts/build-all-in-one.ps1",
    "build:zip": "npm run webpack:build:prod && npm run build:updater:both && electron-builder --win zip",
    "build:zip-only": "powershell -ExecutionPolicy Bypass -File scripts/build-zip-only.ps1",
    "build:win7-32bit": "npm run webpack:build:prod && npm run build:updater:32 && npx electron-builder --win zip --ia32",
    "build:win7-32bit:installer": "npm run webpack:build:prod && npm run build:updater:32 && npx electron-builder --win nsis --ia32 --config.nsis.artifactName=NovaQ_Desk.${ext}",
    "build:win7-32bit-only": "powershell -ExecutionPolicy Bypass -File scripts/build-win7-32bit.ps1",
    "build:universal-win7": "npm run webpack:build:prod && npm run build:updater:both && npx electron-builder --win zip",
    "build:universal-installer": "npm run webpack:build:prod && npm run build:updater:both && npx electron-builder --win nsis --x64 --ia32",
    "clean:portable": "node scripts/clean-portable.js",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "update-server": "node update-server.js",
    "build:release": "./scripts/build-release.sh",
    "build:updater": "nexe updater.js --target windows-x86-14.15.3 --output updater-32.exe",
    "build:updater:32": "nexe updater.js --target windows-x86-14.15.3 --output updater-32.exe",
    "build:updater:64": "nexe updater.js --target windows-x64-14.15.3 --output updater-x64.exe",
    "build:updater:both": "npm run build:updater:32 && npm run build:updater:64"
  },
  "dependencies": {
    "buffer": "^5.7.1",
    "crypto-browserify": "^3.12.0",
    "dotenv": "^17.4.2",
    "electron-store": "^6.0.1",
    "electron-updater": "^4.6.5",
    "node-fetch": "^2.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^3.1.3",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.4"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-react": "^7.12.10",
    "adm-zip": "^0.5.9",
    "babel-loader": "^8.2.2",
    "concurrently": "^6.5.1",
    "copy-webpack-plugin": "^9.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.7",
    "electron": "11.5.0",
    "electron-builder": "22.10.5",
    "express": "^4.17.1",
    "html-webpack-plugin": "4.5.2",
    "nexe": "3.3.7",
    "pkg": "^5.5.2",
    "process": "^0.11.10",
    "style-loader": "^2.0.0",
    "terser-webpack-plugin": "^5.3.15",
    "wait-on": "^6.0.1",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.7.3"
  },
  "engines": {
    "node": ">=12.0.0 <=14.0.0",
    "npm": ">=6.0.0"
  },
  "build": {
    "appId": "com.novaq.desktop",
    "productName": "NovaQ Desktop",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json",
      "updater-32.exe"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://desktop-f96376.gitlab.io/"
      }
    ],
    "artifactName": "NovaQ-Portable-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "ia32",
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "icon": "assets/Logo.ico",
      "publisherName": "Nova Team",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaQ Desktop",
      "installerIcon": "assets/Logo.ico",
      "uninstallerIcon": "assets/Logo.ico",
      "installerHeaderIcon": "assets/Logo.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "NovaQ_Desk-${arch}.${ext}",
      "installerLanguages": [
        "en_US",
        "mn_MN"
      ],
      "language": "1033",
      "multiLanguageInstaller": false,
      "unicode": true,
      "guid": "com.novaq.desktop"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "extraFiles": [
      {
        "from": "updater-32.exe",
        "to": "updater-32.exe"
      }
    ],
    "compression": "maximum",
    "mac": {
      "target": "dmg",
      "icon": "assets/Logopng.png",
      "identity": null,
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/Logopng.png"
    }
  },
  "keywords": [
    "electron",
    "desktop",
    "novaq",
    "finance",
    "banking"
  ],
  "author": "Nova Team",
  "license": "MIT"
}
